# Wimak service — server-side credentials.
#
# Copy this file to .env and fill it in:
#
#     cp .env.example .env
#
# .env is gitignored. This process holds keys that must never reach a browser or
# an installed app, which is why it is a separate service and not part of the
# website.
#
# Unlike admin/.env (which is JSON for --dart-define-from-file), this file is
# ordinary KEY=VALUE, which is what Node's env-file loader expects.
#
# Comments must be on their own line. Neither Node nor `docker --env-file`
# strips an inline "#", so this:
#
#     SMTP_PORT=587   # 465 for TLS
#
# is read as the literal value "587   # 465 for TLS" and the service refuses to
# start. Put every comment on the line above.

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL.
#   ✅ https://abcdefghijklmnop.supabase.co
#   ❌ db.<ref>.supabase.co:5432        (direct Postgres)
#   ❌ postgresql://postgres:...        (contains the database password)
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase → Project Settings → API → secret key.
#   new projects:  sb_secret_...
#   older projects: the service_role JWT (eyJhbGci...)
#
# This key BYPASSES row level security. It is what lets the service create
# bookings, read them for emails, and record payments. It must only ever live on
# a machine you trust.
SUPABASE_SECRET_KEY=sb_secret_...


# ─────────────────────────────────────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────────────────────────────────────

# Stripe → Developers → API keys → secret key.
# Test mode keys (sk_test_...) are the safe way to develop.
STRIPE_SECRET_KEY=sk_test_...

# Stripe → Developers → Webhooks → your endpoint → signing secret.
# Locally, `stripe listen --forward-to localhost:8787/webhooks/stripe` prints a
# whsec_... value to put here. Required: without it the webhook cannot be
# verified, so the service refuses to start.
STRIPE_WEBHOOK_SECRET=whsec_...

# The currency charged. Must match what the catalogue is priced in.
STRIPE_CURRENCY=usd

# Optional. A Stripe Tax Rate id (txr_...) applied to the line item.
STRIPE_TAX_RATE_ID=

# Optional. Let Stripe calculate tax from the customer's location instead.
STRIPE_AUTOMATIC_TAX=false

# Where Stripe sends the customer back to. {REFERENCE} is filled in by the
# service; {CHECKOUT_SESSION_ID} is filled in by Stripe. Leave both as they are.
# Defaults are derived from PUBLIC_SITE_URL.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────────────────────────────────────

# smtp    → delivers through your mail server (the production path)
# resend  → delivers through Resend's HTTP API
# file    → writes each message to EMAIL_LOG_DIR, for checking the rendering
# console → logs the message; used when nothing else is configured
#
# Setting SMTP_HOST switches to SMTP on its own, so this line is optional.
EMAIL_TRANSPORT=smtp

# ── SMTP (EMAIL_TRANSPORT=smtp) ──────────────────────────────────────────────

SMTP_HOST=smtp.example.com

# 587 = STARTTLS (the usual choice), 465 = implicit TLS, 25 = plain/STARTTLS.
SMTP_PORT=587

# true for implicit TLS on 465; false to connect and upgrade with STARTTLS.
# When left blank it is inferred: true only if SMTP_PORT is 465.
SMTP_SECURE=

# Leave both blank for a relay that needs no authentication.
SMTP_USER=
SMTP_PASSWORD=

# Refuse to send if the server does not offer STARTTLS. Sensible on 587.
SMTP_REQUIRE_TLS=false

# Set false only to accept a self-signed certificate on a trusted network.
SMTP_REJECT_UNAUTHORIZED=true

# Socket / greeting timeout, in milliseconds.
SMTP_CONNECTION_TIMEOUT_MS=20000

# The From address. It must be one your SMTP server accepts for the
# authenticated account, or the message is rejected at send time.
EMAIL_FROM="Wimak Total Care <bookings@wimaktotalcare.com>"
EMAIL_REPLY_TO=

# ── Alternatives ─────────────────────────────────────────────────────────────

# Resend, if you prefer its HTTP API (EMAIL_TRANSPORT=resend).
RESEND_API_KEY=

# Required only for EMAIL_TRANSPORT=file.
EMAIL_LOG_DIR=


# ─────────────────────────────────────────────────────────────────────────────
# HTTP
# ─────────────────────────────────────────────────────────────────────────────

# 127.0.0.1 by default: this process holds the secret key, so it belongs behind
# a reverse proxy rather than directly on a public interface.
HOST=127.0.0.1
PORT=8000

# The website's origin. Used for the default Stripe return URLs and CORS.
PUBLIC_SITE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Optional. When set, enables
# POST /api/bookings/:reference/emails/:kind/resend with a Bearer token.
ADMIN_API_TOKEN=

# Set to true when a reverse proxy terminates TLS in front of this service.
TRUST_PROXY=false

# debug | info | warn | error
LOG_LEVEL=info
